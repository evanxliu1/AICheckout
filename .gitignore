# Dependencies
node_modules/

# Environment and secrets
.env
**/.env.*
!**/.env.example

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Build output and logs
dist/
build/
coverage/
*.log

# Local assistant notes
**/CLAUDE.md
# Claude Code: the project skills and subagent definitions are committed; local settings
# (settings.local.json), agent worktrees and anything else under .claude/ stay local.
/.claude/*
!/.claude/skills/
!/.claude/agents/
**/DOCUMENTATION_GUIDE.md

# Intermediate release-media renders
docs/release/assets/video-captions/
docs/release/assets/full-stack-captions/

# Local verification and packaged artifacts
extension/artifacts/
extension/test-results/
extension/playwright-report/
apps/review/test-results/
apps/review/playwright-report/
packages/ui/test-results/
apps/site/test-results/
apps/site/playwright-report/
packages/ui/playwright-report/
extension/dist-catalog-test/
extension/dist-e2e/

# Private curation observations and experiment reports
/evals/curation/runs/

# Captured issuer page text is copyrighted; commit only the manifest (URLs, hashes)
/evals/curation/real/captures/
/evals/curation/real/merchant-captures/
/evals/curation/real/verification*.html

# Retired prototype (local copy only; holds old secrets)
simulation/

# Raw deep-research notes (synthesized into docs/research/)
research_notes/
/evals/curation/expansion/captures/
/evals/curation/expansion/extractions/
/evals/curation/expansion/parts/
/evals/curation/expansion/extractions-*/
# Pipeline batches (tools/catalog-pipeline): each batch's captures, traces and capture-run parts stay local.
/evals/curation/batches/*/captures/
/evals/curation/batches/*/captures-dropped/
/evals/curation/batches/*/extractions/
/evals/curation/batches/*/parts/
# Work packets hold this machine's absolute paths; state.json records what was accepted (packetId, run, model).
/evals/curation/batches/*/pipeline/packets/
# Draft labels, product notes, verifier packets and verification findings are committed: every quote in them is
# at most 25 words (scripts/check-expansion-quotes.mjs checks them against the captures before a commit).

# Agent scratch directories (local only)
scratchpad/

# Phase 10 merchant probe: snapshots, screenshots, the Tranco file, home-page probes and the probe's Chrome profile
# hold retailer page content or browsing state. Only the README, the prototype scripts and the text-free site list
# and labels (domains, amounts, kinds, hashes) are committed.
/evals/merchants/probe/data/
/evals/merchants/probe/profile/

# Phase 12 reader eval: the Tranco copy and frame-building inputs (third-party list). The frame, the held-out
# domain list and the selection script are committed.
/evals/merchants/data/
