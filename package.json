{
  "name": "ai-checkout",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "extension",
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint extension/src extension/tests extension/e2e extension/scripts packages apps scripts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:scripts",
    "build": "npm run build --workspaces --if-present",
    "release:media": "node scripts/build-release-media.mjs",
    "release:portfolio": "node scripts/build-portfolio-demo.mjs",
    "test:catalog:browser": "node scripts/test-catalog-browser.mjs",
    "supabase": "supabase",
    "db:start": "supabase db start",
    "db:start:api": "supabase start --exclude realtime,storage-api,imgproxy,mailpit,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db --local",
    "db:test:concurrency": "node scripts/test-db-concurrency.mjs",
    "db:test:catalog": "node scripts/test-catalog-parity.mjs",
    "db:test:http": "node scripts/test-catalog-http.mjs",
    "db:test:curation": "node scripts/test-curation-ledger.mjs",
    "db:test:curation:http": "node scripts/test-curation-http.mjs",
    "db:test:curation:application": "node scripts/test-curation-application.mjs",
    "eval:curation": "node scripts/evaluate-curation.mjs",
    "eval:v2": "node scripts/evaluate-curation-v2.mjs",
    "db:lint": "supabase db lint --local --schema public,catalog_private --fail-on warning",
    "db:advisors": "supabase db advisors --local --type security --level warn --fail-on error",
    "db:seed:generate": "node scripts/generate-db-seed.mjs",
    "db:seed:check": "node scripts/generate-db-seed.mjs --check",
    "catalog:v2": "node scripts/build-catalog-v2.mjs",
    "catalog:v2:check": "node scripts/build-catalog-v2.mjs --check",
    "catalog:v3": "node scripts/build-catalog-v3.mjs",
    "catalog:v3:check": "node scripts/build-catalog-v3.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:scripts": "node --test \"scripts/lib/*.test.mjs\"",
    "eval:matrix": "node scripts/run-eval-matrix.mjs",
    "eval:summarize": "node scripts/summarize-evals.mjs"
  },
  "devDependencies": {
    "@types/node": "24.6.1",
    "pg": "8.23.0",
    "prettier": "3.9.9",
    "supabase": "2.118.0"
  }
}
