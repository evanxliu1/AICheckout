  "scope": "Real local React → compiled Node API → Supabase Auth/PostgreSQL. Invented terms and intercepted SDK responses; no live model, billing or hosted publication.",
  "chapters": [
    {
      "seconds": 0.172,
      "title": "Sign in to review",
      "text": "Disposable local account. React connects to the compiled Node API and local Supabase Auth."
    },
    {
      "seconds": 3.648,
      "title": "Start from a saved draft",
      "text": "A revision and captured source identify the input. These invented 2.5% terms are demonstration data."
    },
    {
      "seconds": 8.201,
      "title": "Request bounded extraction",
      "text": "The real SDK runs through a blocked, simulated transport. No live model call or provider charge occurs."
    },
    {
      "seconds": 12.973,
      "title": "Inspect facts and exact quotations",
      "text": "Each field points to a saved source span. Matching evidence is a mechanical check, not proof of correct interpretation."
    },
    {
      "seconds": 19.026,
      "title": "Review every condition",
      "text": "A reviewer identifies which existing rules cover a condition and records a reason before applying anything."
    },
    {
      "seconds": 24.622,
      "title": "Approve a draft change",
      "text": "The proposed rate changes from 1.5% to the invented 2.5%. A review note and fresh acknowledgement are required."
    },
    {
      "seconds": 30.207,
      "title": "Apply without publishing",
      "text": "The API creates a new draft revision and records the review. The public catalog remains unchanged."
    },
    {
      "seconds": 34.928,
      "title": "Inspect the saved review",
      "text": "The saved application records the revision and condition decisions. Refreshing a run reads the ledger without another model request."
    },
    {
      "seconds": 39.648,
      "title": "Inspect context and accounting",
      "text": "The saved run exposes prompt/schema versions, context identity and attempts. Token and cost values here are simulated."
    },
    {
      "seconds": 45.761,
      "title": "Publish in a separate action",
      "text": "A second review confirms the complete draft. Publication is bound to its exact revision, hash and current catalog head."
    },
    {
      "seconds": 50.946,
      "title": "Verify the public result",
      "text": "The local public endpoint now returns the reviewed revision. Cleanup restores the previous head and removes all demo records."
    }
  ],
