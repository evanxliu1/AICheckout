# These are public browser configuration values, not privileged secrets.
# If using a different project, update manifest.json host_permissions too.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-publishable-or-anon-key
# Optional public catalog API. Build grants access to this single HTTPS origin.
# No endpoint = offline development build; release packaging must configure one.
# VITE_CATALOG_API_URL=https://your-api.example/v1/catalog
