{
  "name": "ai-checkout-extension",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.e2e.json",
    "test": "vitest run && node --test scripts/package.test.mjs",
    "test:package": "node --test scripts/package.test.mjs",
    "test:package:browser": "npm run package && RELEASE_ZIP_E2E=1 playwright test e2e/package.spec.ts",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.58.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.6.5",
    "zustand": "5.0.8",
    "@ai-checkout/rewards-core": "2.0.0",
    "@ai-checkout/catalog-client": "2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "10.4.21",
    "baseline-browser-mapping": "2.11.26",
    "eslint": "9.36.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.22",
    "globals": "16.4.0",
    "jsdom": "29.1.1",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.18",
    "typescript": "5.8.3",
    "typescript-eslint": "8.45.0",
    "vite": "7.3.6",
    "vitest": "5.0.2",
    "@crxjs/vite-plugin": "2.7.1",
    "@types/chrome": "0.1.16",
    "dotenv": "17.2.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
