{
  "schemaVersion": 1,
  "merchantId": "newegg-us",
  "name": "Newegg US",
  "extractorVersion": "newegg-summary-v1",
  "observed": {
    "on": "2026-09-26",
    "note": "Newegg US cart summary: a selected subtotal row and an Est. Total row that shows TBD until an address is known. Only those two rows are read; never the delivery address or promotion form."
  },
  "match": { "hosts": ["secure.newegg.com"], "paths": ["^/shop/cart/?$"] },
  "summary": { "selector": ".summary-side", "maxCount": 3 },
  "emptyCart": { "selector": ".cart-empty > h3", "text": "Your cart is currently empty." },
  "loading": { "busyAncestor": "[aria-busy=\"true\"]", "checkMatchedRows": true, "indicators": [] },
  "rows": { "selector": ":scope > .summary-wrap > .summary-content > ul > li", "max": 30 },
  "label": { "selectors": [":scope > label"], "single": true },
  "amount": { "selector": ":scope > span" },
  "labels": [
    { "pattern": "^Selected Subtotal$", "caseInsensitive": false, "kind": "subtotal" },
    { "pattern": "^Est\\. Total$", "caseInsensitive": false, "kind": "estimated-total" }
  ],
  "pending": [{ "kind": "estimated-total", "text": "TBD" }],
  "requiredKinds": ["subtotal", "estimated-total"],
  "duplicates": "ambiguous",
  "combine": "per-summary"
}
