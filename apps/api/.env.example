SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
HOST=127.0.0.1
PORT=3000
# Built review UI, relative to the repository root when starting the server there.
REVIEW_DIST_DIR=apps/review/dist
# Built public site (apps/site), served at / behind the API and review routes.
SITE_DIST_DIR=apps/site/dist
# Paid providers remain disabled. The local integration test provisions its own scoped login.
CURATION_ADAPTER=disabled
CURATION_ALLOW_METERED=false
# Set a server-only key only after choosing an explicit dated model, price ceilings,
# and an authorized database spending policy. Never put it in extension/review builds.
# OPENAI_API_KEY=
# Per-process/source-IP extraction requests per minute (1–60).
CURATION_RATE_LIMIT=3
# CURATION_DATABASE_URL=postgresql://dedicated_login:password@127.0.0.1:54322/postgres
# CURATION_PROFILE_ID=your-operator-configured-profile
# CURATION_DATABASE_CA_FILE=/absolute/path/to/database-ca.crt
